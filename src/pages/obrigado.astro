---
// Estática: página SSR em produção no CF Pages sai como "[object Object]" (mesmo bug da index).
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { COOKIE_LEAD, OFERTA_8LINKS } from '../lib/settings';
---

<BaseLayout
  title="Cadastro confirmado — sua análise está a caminho | Bruno Medeiros"
  description="Você entrou na lista da análise gratuita ao vivo. O link da aula foi enviado para o seu email."
  noindex
>
  <div id="obrigado" class="container" style="padding-block:48px 64px;max-width:560px" hidden>
    <div class="card" style="padding:40px 32px;text-align:center">
      <p class="mono" style="color:var(--orange);font-size:13px;margin:0 0 8px">// confirmado</p>
      <h1 style="font-size:clamp(26px,6vw,38px)">
        Tá dentro! <span style="color:var(--orange)">🎯</span>
      </h1>
      <p class="muted" style="font-size:16px">
        Acabei de enviar <strong style="color:var(--txt)">o link da aula para o seu email</strong>.
      </p>

      <div class="bloco" style="text-align:left">
        <p class="rotulo mono">Próximo passo · abra seu email</p>
        <ol class="passos muted small">
          <li>Procure o email <strong style="color:var(--txt)">“Sua análise gratuita está confirmada”</strong>.</li>
          <li>Clique no botão e faça sua inscrição no Zoom — é por lá que chega o acesso da aula.</li>
          <li>A aula é <strong style="color:var(--txt)">toda terça, às 22h</strong>. Traz teu site que eu analiso ao vivo.</li>
        </ol>
        <p class="muted small" style="margin:10px 0 0">
          Não chegou em alguns minutos? Dá uma olhada no spam ou na aba Promoções.
        </p>
      </div>
    </div>

    <section class="card oferta" aria-labelledby="oferta-titulo">
      <p class="mono selo">// oferta exclusiva pra quem se cadastrou</p>
      <h2 id="oferta-titulo">
        8links: seus backlinks <span style="color:var(--orange)">no automático</span>
      </h2>
      <p class="muted" style="font-size:15px;margin:0 0 20px">
        A 8links é a minha plataforma de criação automática de backlinks. Como você entrou na lista
        da análise, liberei uma condição que só aparece aqui:
      </p>
      <p class="preco">
        <span class="de">de <s>{OFERTA_8LINKS.precoDe}</s></span>
        <span class="por">por <strong>{OFERTA_8LINKS.precoPor}</strong></span>
      </p>
      <a href={OFERTA_8LINKS.url} target="_blank" rel="noopener" class="btn" style="text-decoration:none;display:block">
        Quero a 8links por {OFERTA_8LINKS.precoPor} →
      </a>
      <p class="muted small" style="margin:12px 0 0;text-align:center">Pagamento seguro via Kiwify.</p>
    </section>
  </div>
  <script is:inline define:vars={{ cookieLead: COOKIE_LEAD }}>
    // Só quem concluiu o cadastro (cookie gravado pelo /api/cadastro) vê a página e a oferta.
    if (document.cookie.split('; ').some((c) => c.startsWith(cookieLead + '='))) {
      document.getElementById('obrigado').hidden = false;
    } else {
      window.location.replace('/');
    }
  </script>
</BaseLayout>

<style>
  .bloco {
    margin-top: 24px;
    padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    background: var(--bg3);
  }
  .rotulo {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--orange);
    margin: 0 0 10px;
  }
  .passos {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }
  .oferta {
    margin-top: 24px;
    padding: 32px;
    border: 1px solid var(--border-hover);
    background: linear-gradient(180deg, rgba(232, 116, 59, 0.08), transparent 60%), var(--bg2);
  }
  .oferta h2 {
    font-size: clamp(22px, 5vw, 28px);
    margin: 0 0 12px;
  }
  .selo {
    color: var(--orange);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 10px;
  }
  .preco {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin: 0 0 20px;
  }
  .de {
    color: var(--gray);
    font-size: 15px;
  }
  .por {
    color: var(--txt);
    font-size: 18px;
  }
  .por strong {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 34px;
    color: var(--orange);
  }
  .small {
    font-size: 13px;
  }
</style>
